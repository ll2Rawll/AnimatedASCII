{
  "name": "winter-ascii",
  "version": "2.2.0",
  "description": "Live Christmas, neon abstract, and Y2K wallpapers drawn in ASCII",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite --host 0.0.0.0",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.winterascii.app",
    "productName": "AnimatedASCII",
    "win": {
      "target": "nsis"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.js",
      "wallpaper.ps1",
      "preload.js",
      "motion.js",
      "abstract.js",
      "y2k.js",
      "assets/*.webp"
    ],
    "asarUnpack": [
      "wallpaper.ps1"
    ]
  }
}
